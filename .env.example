DWELL_BIND=127.0.0.1
DWELL_PORT=8765
DWELL_DATA_DIR=./data

# ChatGPT resident MCP. The generated private token stays in this 0600 file;
# the owner-only /mcp-link page shows the complete connection URL.
DWELL_MCP_PUBLIC_BASE=
DWELL_MCP_TOKEN_FILE=./data/mcp-route-token
DWELL_MCP_OWNER_CHECK_URL=
DWELL_MCP_OWNER_USER_ID=
DWELL_MCP_RESIDENT_NAME=驻客

# Set this before exposing the app beyond loopback.
DWELL_PASSWORD=

# OpenAI-compatible Chat Completions endpoint.
DWELL_API_BASE=
DWELL_API_TOKEN=
DWELL_MODEL=

# Optional OpenAI-compatible embeddings for semantic/hybrid resident history search.
# If BASE/TOKEN are empty they fall back to DWELL_API_BASE/TOKEN. Message text is
# sent to this provider for indexing, so choose a provider appropriate for private data.
DWELL_EMBEDDING_BASE=
DWELL_EMBEDDING_TOKEN=
DWELL_EMBEDDING_MODEL=

# Separately running sibylsea-hub/gpt-thinking-block-mcp service.
THINKING_MCP_URL=http://127.0.0.1:8787/mcp

# Optional sticker MCP used only by the main chat and its manual picker.
# Provide your own endpoint; leave empty to disable sticker search/send.
DWELL_STICKER_MCP_URL=

# Optional second-room model. Empty values fall back to the main model.
DWELL_SECOND_API_BASE=
DWELL_SECOND_API_TOKEN=
DWELL_SECOND_MODEL=

DWELL_REPO_PATH=.

# Night heartbeat; the UI toggle is off until enabled by the user.
DWELL_WAKE_MAX=2
DWELL_WAKE_QUIET_SECONDS=2400
DWELL_WAKE_GAP_SECONDS=11400

# Optional argv-style command used only by the explicit "rewake" button.
DWELL_REWAKE_COMMAND=

# Subscription storage works without these; delivery needs a VAPID sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
